<Window x:Class="Login.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Login.ViewModels"
        Title="Iniciar Sesión" Height="300" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bienvenido" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Usuario:"/>
            <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Contraseña:"/>
            <PasswordBox x:Name="txtPassword" Height="28"/>
        </StackPanel>

        <TextBlock Text="{Binding MensajeError}" Grid.Row="3" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}"/>

        <Button Content="Ingresar" Grid.Row="4" Height="32"
                Command="{Binding LoginCommand}"
                CommandParameter="{Binding ElementName=txtPassword, Path=Password}" Click="Button_Click"/>
    </Grid>
</Window>